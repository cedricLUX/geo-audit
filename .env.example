# Toutes les clés sont optionnelles : un moteur sans clé tourne en mode démo.
OPENAI_API_KEY=          # ChatGPT (API Responses + recherche web)
OPENAI_MODEL=gpt-5-mini
SERPAPI_API_KEY=         # Aperçu IA de Google (via SerpApi)
PERPLEXITY_API_KEY=      # Perplexity Sonar
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=          # Gemini + recherche Google
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=       # Claude (moteur interrogé) + analyse des réponses
CLAUDE_MODEL=claude-opus-5-5
ANALYSIS_MODEL=claude-opus-5-5

# Signature des jetons d'audit (obligatoire en production)
AUDIT_SECRET=change-me

# Optionnel : stockage des e-mails et audits (sinon mémoire du serveur)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Limite d'audits par e-mail et par jour quand au moins un moteur est réel
AUDITS_PER_DAY=1
